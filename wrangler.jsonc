{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pipedrive-smart-lead",
	"main": "src/index.js",
	"compatibility_date": "2026-07-09",
	"vars": {
		"PIPEDRIVE_CLIENT_ID": "86566d2a97defcd2",
		"PIPEDRIVE_CLIENT_SECRET": "9b79d6cd74009b031cf6ede5fb56c1f02de9680b",
		"PIPEDRIVE_JWT_SECRET": "smart-assignment-jwt-secret-demo-2026",
		"PIPEDRIVE_WEBHOOK_AUTH_USER": "pipedrive-webhook",
		"PIPEDRIVE_WEBHOOK_AUTH_PASSWORD": "very-long-random-secret",
		"GEMINIAPIKEY": "AQ.Ab8RN6Lf6kbwI2P_G7DjpCQMGJlKt66gCcxX6my9dvuurSiWdg",
		"RATE_LIMIT_WINDOW_SECONDS": 60,
		"RATE_LIMIT_JSON_LEAD_SCORING": 60,
		"RATE_LIMIT_BITCOIN_PANEL": 120,
		"RATE_LIMIT_SAVE_CAPACITIES": 20,
		"RATE_LIMIT_ASSIGN": 60,
		"RATE_LIMIT_ASSIGNMENT_SUMMARY": 120,
		"RATE_LIMIT_COMPANY_SALES_ANALYSIS": 10,
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pipedrive-smart-lead-db",
			"database_id": "7a582261-cbaa-452c-955b-50cc00fd24ea",
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
